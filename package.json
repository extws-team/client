{
	"name": "@extws/client",
	"version": "0.3.0-dev",
	"description": "Client for ExtWS",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/server/main.js",
	"types": "dist/server/main.d.ts",
	"unpkg": "dist/browser/main.min.js",
	"jsdelivr": "dist/browser/main.min.js",
	"exports": {
		".": {
			"types": {
				"import": "./dist/server/main.d.ts",
				"require": "./dist/server/main.d.cts"
			},
			"import": "./dist/server/main.js",
			"require": "./dist/server/main.cjs",
			"browser": "./dist/browser/main.js"
		}
	},
	"dependencies": {
		"@extws/server": "github:extws-team/server#9625673278a8a7539883bf0b6afdbdd44f9c9402",
		"neoevents": "0.2.2",
		"ws": "8.18.3"
	},
	"devDependencies": {
		"@extws/server-uws": "github:extws-team/server-uws#0ed1b2bf182f6858b4ce0ff47370bf481a4b61f9",
		"@kirick/eslint-config": "0.1.30",
		"@types/bun": "^1.2.18",
		"@types/node": "^22.9.0",
		"@types/ws": "^8.5.13",
		"eslint": "9.10.0",
		"publint": "^0.3.12",
		"tsdown": "^0.10.0",
		"typescript": "5.8.3",
		"unplugin-unused": "^0.4.4",
		"vitest": "3.1.3"
	},
	"scripts": {
		"build": "rm -r dist ; bun run build:server && bun run build:browser",
		"build:browser": "rm -r dist/browser ; bun run build/browser.ts",
		"build:server": "tsdown src/main.ts --unused --dts --format esm --format cjs --out-dir dist/server",
		"check": "bun run lint && bun run build && publint && bun run test",
		"lint": "eslint . && tsc",
		"test": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/client.git"
	},
	"keywords": [
		"extws",
		"websocket",
		"client",
		"rtc"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/client/issues"
	},
	"homepage": "https://github.com/extws-team/client#readme"
}
